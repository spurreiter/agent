ARG FROM_IMAGE=docker.io/library/ubuntu:26.10
FROM $FROM_IMAGE

ARG USER_ID=1000
ARG ARCH=arm64
## to allow network access, set to "true"
ARG network=true

ENV LANG="en_US.UTF-8"
ENV LC_CTYPE="en_US.UTF-8"
ENV HOME="/home/agent"
ENV PATH="$HOME/.local/share/npm/bin:$HOME/.local/share/go/bin:$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

RUN apt-get update \
&& apt-get upgrade -y \
&& env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
	bsdmainutils \
	bubblewrap \
	build-essential \
	ca-certificates \
	coreutils \
	curl \
	fd-find \
	file \
	git \
	jq \
	less \
	python3 \
	ripgrep \
	tmux \
	tree \
	vim \
	vim-common \
	xxd \
&& mkdir -p /usr/local/bin \
&& ln -sf "$(which fdfind)" /usr/local/bin/fd

## install network tools
RUN if [ "$network" = "true" ]; then apt-get install -y --no-install-recommends \
	socat \
;fi

## additional installations
RUN apt-get install -y --no-install-recommends \
	python3-dev \
	python3-pip \
	python3-venv \
	uv \
	default-jre \
	plantuml \
	graphviz

## install node@lts - https://github.com/tj/n/tree/master/bin
ARG node_version=26
RUN curl -fsSL https://raw.githubusercontent.com/tj/n/584a616/bin/n | bash -s install $node_version

## install rtk - https://github.com/rtk-ai/rtk
RUN curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/refs/heads/master/install.sh | env RTK_INSTALL_DIR=/usr/local/bin sh

## install go - https://go.dev/dl/
ARG go_version=1.27.1
RUN curl -fsSL "https://go.dev/dl/go${go_version}.linux-${ARCH}.tar.gz" | tar -xz -C /usr/local

## install rust - https://rust-lang.org/tools/install/
RUN curl -fsSL https://sh.rustup.rs | env CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/bin/rustup sh -s -- --default-toolchain stable --profile default -y

## get install scripts required by setup.sh
RUN curl -fsSL https://raw.githubusercontent.com/ohmybash/oh-my-bash/master/tools/install.sh -o /usr/local/oh-my-bash.sh \
&& curl -fsSL https://claude.ai/install.sh -o /usr/local/claude-code.sh


## cleanup apt
RUN if [ "$network" != "true" ]; then \
	apt remove -y curl \
	&& apt autoremove -y \
;fi
RUN rm -rf /var/lib/apt/lists/*

## agent user is created with same id of user building the image
RUN userdel -r ubuntu \
&& groupadd --gid $USER_ID agent \
&& useradd --uid $USER_ID --gid agent --shell /bin/bash --create-home agent

USER agent
WORKDIR /home/agent/ws
